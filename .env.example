VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_DOCUMENTS_TABLE=app_documents
VITE_SUPABASE_STORAGE_BUCKET=a3hub

VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Optional deploy profile: full, academic, learning, operations, lean
VITE_DEPLOY_PROFILE=full

# Optional browser Web Push config.
VITE_PUSH_NOTIFY_ENABLED=false
VITE_PUSH_VAPID_KEY=your-web-push-vapid-public-key
VITE_PUSH_SW_URL=/push-sw.js
VITE_EMAIL_NOTIFY_ENABLED=true
VITE_EMAIL_NOTIFY_ENDPOINT=supabase:functions:email-send

# Development only. Keep false for production builds.
VITE_ALLOW_CLIENT_AI_KEY=false
# Development only. Do not ship these in a production client build.
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=

# Netlify server variables for authenticated functions:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-server-only-use
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional for server-side verification-link resend:
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
# RESEND_API_KEY=
# EMAIL_FROM=A3 Hub <no-reply@yourdomain.com>
